<?xml version="1.0" encoding="UTF-8"?>
<!-- Nur für die Tests: veraPDF (PDF/A-Prüfung der Protokolle und Berichte) aus Maven Central, mit fester Version.
     Der Workflow „Tests“ (Schritt „veraPDF für die PDF/A-Prüfung“) holt es samt Abhängigkeiten mit
     dependency:copy-dependencies in einen Ordner und gibt den Tests den Aufruf in VERAPDF:
     java -cp "<ordner>/*" org.verapdf.apps.GreenfieldCliWrapper – siehe tests/test_material.py, pdfa_pruefer.
     Zum Heben: version ändern. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.stroemis.tests</groupId>
  <artifactId>verapdf</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <dependencies>
    <dependency>
      <groupId>org.verapdf.apps</groupId>
      <artifactId>greenfield-apps</artifactId>
      <version>1.28.2</version>
    </dependency>
  </dependencies>
</project>

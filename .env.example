# --- Pflicht -----------------------------------------------------------------
# Öffentliche Adresse (für Links in E-Mails). Umlaut-Domain ist erlaubt.
BASE_URL=https://strömis.de

# Erster Administrator – wird beim Start angelegt, falls er noch nicht existiert.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=bitte-aendern-mindestens-8-zeichen

# --- Optional ----------------------------------------------------------------
# Signaturschlüssel für Sessions. Leer lassen → wird einmalig erzeugt und unter /data/secret_key abgelegt.
SECRET_KEY=

# Dürfen sich Nutzer selbst registrieren? (true/false). Sonst legt der Admin die Konten an.
ALLOW_REGISTRATION=true

# Cookies nur über HTTPS senden. Für den Betrieb hinter TLS true lassen.
# ACHTUNG beim ersten Ausprobieren über http://127.0.0.1:8080: der Browser verwirft ein
# Secure-Cookie auf einer HTTP-Seite – die Anmeldung gelingt, führt aber sofort wieder auf
# die Anmeldeseite zurück. Dafür hier false setzen.
COOKIE_SECURE=true

# Maximale Größe eines Hochladevorgangs (alle Dateien zusammen) in MB. 5120 = 5 GB.
MAX_UPLOAD_MB=5120

# Größe einer gewöhnlichen Anfrage ohne Upload in MB – begrenzt auch, wie lang eine
# Wiki-Seite werden darf.
MAX_REQUEST_MB=1

# Name der Anwendung in Betreffzeilen und Absendern.
SITE_NAME=strömis.de

# Öffentliches Wiki: Subdomain (Host-Header) und Adresse für Freigabe-Links.
PUBLIC_HOST=wiki.strömis.de
PUBLIC_URL=https://wiki.strömis.de

# Benachrichtigung bei Kontoanfragen – leer = an alle Administratoren.
ADMIN_NOTIFY_EMAIL=

# Slideshow mit Bildern aus den Spots auf der Anmeldeseite (true/false).
LOGIN_SLIDESHOW=true

# E-Mail-Versand für „Passwort vergessen“. Ohne SMTP_HOST landet der Link nur im Container-Log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=strömis.de <noreply@xn--strmis-yxa.de>
# Absender des Umschlags (Return-Path). Leer lassen heißt: die Adresse aus MAIL_FROM. Gegen sie
# prüft der Empfänger SPF, und DMARC verlangt, dass sie zur Domain in MAIL_FROM passt. Nur
# setzen, wenn der Versanddienst eine eigene Adresse verlangt oder Rückläufer woanders hinsollen.
SMTP_ENVELOPE_FROM=

# Wie viele Fassungen einer Wiki-Seite bleiben im Verlauf? 0 = alle behalten.
WIKI_MAX_REVISIONS=100

# Karte: Startansicht und Kachelquellen
MAP_CENTER=51.0,10.4
MAP_ZOOM=6
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TOPO_URL=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
# Adresssuche beim Platzieren von Bildern (leeren schaltet sie ab).
GEOCODE_URL=https://nominatim.openstreetmap.org/search
# Luftbild – die Startebene der Spots-Karte. Leeren, wenn nur die Straßenkarte gezeigt werden soll.
SAT_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# Beschriftung über dem Luftbild: Straßen mit Namen, Orts- und Gewässernamen. Ohne sie sieht man
# die Kiesbank, weiß aber nicht, an welchem Fluss. Mehrere Ebenen durch Komma, von unten nach
# oben gestapelt; leeren schaltet sie ab. Sie erscheint nur zum Luftbild, nicht zur Straßenkarte.
SAT_LABELS_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x},https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}
# Rechtehinweise unter der Karte. Leer lassen heißt: die Vorgaben von OpenStreetMap,
# OpenTopoMap und Esri werden angezeigt.
TILE_ATTRIBUTION=
TOPO_ATTRIBUTION=
SAT_ATTRIBUTION=

# --- Videos ----------------------------------------------------------------------
# Nach jedem Start wandelt ein Hintergrundlauf Bestandsvideos, die nicht jeder Browser
# abspielt (HEVC aus dem iPhone), nach H.264 – genau wie beim Hochladen. 0 schaltet ihn ab.
# VIDEOPFLEGE=1
